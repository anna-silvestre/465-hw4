
# Rule 1: Detect the fake secret in an outbound HTTP request body
alert http 172.30.0.10 any -> any any (
    msg:"HW4 ALERT - Fake secret exfiltration detected";
    flow:established,to_server;
    http.request_body;
    content:"CSCE465-FAKE-TOKEN-2f67e97a501147ce";
    sid:1000001;
    rev:1;
)

# Rule 2: Detect the adversarial course marker in the web response
alert http 172.30.0.40 any -> 172.30.0.10 any (
    msg:"HW4 ALERT - Adversarial webpage marker detected";
    flow:established,to_client;
    http.response_body;
    content:"CSCE465-COURSE-MARKER";
    sid:1000002;
    rev:1;
)

# Rule 3: Detect TCP connections from agent-node to mock-c2
alert tcp 172.30.0.10 any -> 172.30.0.66 8080 (
    msg:"HW4 ALERT - Agent connecting to mock C2";
    flags:S;
    flow:stateless;
    sid:1000003;
    rev:1;
)
